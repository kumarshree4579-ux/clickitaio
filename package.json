{
  "name": "ecom-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --prefix packages/api",
    "build:api": "npm run build --prefix packages/api",
    "start:api": "npm run start --prefix packages/api",
    "dev:admin": "npm run dev --prefix apps/admin",
    "build:admin": "npm run build --prefix apps/admin",
    "start:admin": "npm run start --prefix apps/admin",
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "start:web": "npm run start --prefix apps/web"
  }
}